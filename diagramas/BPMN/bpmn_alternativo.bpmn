  <bpmn:process id="Proceso_Asignacion_Inteligente" name="Gestión inteligente de tutorías de trabajo de grado (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_3" name="Docente tutor">
        <bpmn:flowNodeRef>Task_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_teacherconfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_teacherok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Coordinación académica">
        <bpmn:flowNodeRef>Task_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_reassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Sistema PWA con REDES NEURONALES">
        <bpmn:flowNodeRef>Task_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_nn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_candidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_slots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0" name="Estudiante">
        <bpmn:flowNodeRef>Task_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_studentconfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_alternate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_studentok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Task_start" name="Necesita tutor de grado">
      <bpmn:outgoing>Flow_00</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_submit" name="Registra tema, resumen y disponibilidad">
      <bpmn:incoming>Flow_00</bpmn:incoming>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_validate" name="Valida datos de solicitud">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Task_valid" name="¿Datos completos?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_correct" name="Completa o corrige solicitud">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_profile" name="Analiza tema y perfil del proyecto">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_nn" name="Red neuronal clasifica afinidad tutor–tema">
