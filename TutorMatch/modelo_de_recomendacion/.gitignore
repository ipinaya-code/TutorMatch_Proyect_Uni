# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribuciones y empaquetado
build/
dist/
*.egg-info/
.eggs/

# Entornos virtuales
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Variables de entorno locales
.env
!.env.example

# IDEs y Editores
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints

